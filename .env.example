# ==============================================================================
# SMART KISAN 🌱 - ENVIRONMENT CONFIGURATION
# Copy this file to .env and provide your secret API keys
# ==============================================================================

# Database Configuration (PostgreSQL in production, SQLite for local fallback)
DATABASE_URL=sqlite:///./smart_kisan.db
# For production Neon / Render PostgreSQL:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Gemini API Key (Enables Generative AI reasoning & RAG for Smart Kisan Assistant)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# India Meteorological Department (IMD) API (Optional - Official registered access)
# https://api.imd.gov.in/public/
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in/public

# Open-Meteo Weather API Base URLs (No API key required for non-commercial open science)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1

# ISRIC SoilGrids REST API (Active with curated regional dataset fallback)
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0

# Administrative API Security Key (For secure dataset re-importing)
ADMIN_API_KEY=smartkisan_admin_secret_2026

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
